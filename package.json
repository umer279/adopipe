{
  "name": "adopipe",
  "version": "0.1.0",
  "description": "Azure DevOps pipeline results CLI built for AI agents: compact JSON, failure extraction, test analysis, trends and diffs.",
  "type": "module",
  "bin": {
    "adopipe": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "AGENTS.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT",
  "dependencies": {
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
